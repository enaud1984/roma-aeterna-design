    {
      "title": "Executive summary",
      "intro": "Roma Aeterna e un RPG open world sandbox storico nel quale il giocatore e una persona comune inserita in una societa autonoma. La promessa non e il dominio garantito del mondo, ma la possibilita di costruire una vita credibile dentro sistemi sociali, economici, politici e religiosi persistenti.",
      "sections": [
        {"title": "Il progetto in breve", "sources": ["01-vision/creative-vision.md", "01-vision/game-design-bible/player-promise.md", "07-pompeii-demo/design/demo-charter.md"], "table": "project_facts"},
        {"title": "Obiettivi, pubblico ed elementi distintivi", "sources": ["01-vision/game-design-bible/experience-goals.md", "01-vision/design-pillars.md", "01-vision/scope-and-non-goals.md"]},
        {"title": "Stato del progetto e vincolo di readiness", "sources": ["READY_FOR_IMPLEMENTATION.md", "11-production/roadmap-backlog/implementation-readiness-matrix.md"], "table": "readiness"}
      ]
    },
